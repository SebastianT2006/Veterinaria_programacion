@page
@model front_veterinaria.Pages.Ventanas.RazasModel
@{ ViewData["Title"]="Razas"; }
<form method="post"><div class="text-center"><h1 class="display-4">Razas</h1><div><input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" /> <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" /> <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" /><input placeholder="Buscar" asp-for="Filtro!.Nombre" /></div>@if(ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }@if(Model.Formulario||Model.Borrar) {<input type="hidden" asp-for="Actual!.Id" />}@if(Model.Formulario) {<div><h3>Razas</h3><label>Especie</label><select class="form-control" asp-for="Actual!.Especie" asp-items="@(new SelectList(Model.Especies, "Id", "Nombre"))"></select><br />
<label>Nombre</label><input class="form-control" asp-for="Actual!.Nombre" type="text" step="any" /><br />
<label>TamanoPromedio</label><input class="form-control" asp-for="Actual!.TamanoPromedio" type="number" step="any" /><br />
<label>PesoPromedio</label><input class="form-control" asp-for="Actual!.PesoPromedio" type="number" step="any" /><br />
<label>EsperanzaVidaAnios</label><input class="form-control" asp-for="Actual!.EsperanzaVidaAnios" type="number" step="any" /><br />
<label>Descripcion</label><input class="form-control" asp-for="Actual!.Descripcion" type="text" step="any" /><br /></div>}@if(Model.Borrar) {<div class="popup"><div class="pp_del_inner"><h3>Mensaje</h3><h4>¿Quiere borrar el registro #@Model.Actual!.Id?</h4><input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar"/><input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtBorrar"/></div></div>}@if(!Model.Formulario) {<div class="containers_vn panel panel-default"><table class="tb_data table table-striped table-bordered table-hover"><tr><th>Especie</th><th>Nombre</th><th>TamanoPromedio</th><th>PesoPromedio</th><th>EsperanzaVidaAnios</th><th>Descripcion</th><th>Acción</th></tr>@foreach(var elemento in Model.Lista) {<tr><td>@(Model.Especies.FirstOrDefault(x => x.Id == elemento.Especie)?.Nombre)</td><td>@elemento.Nombre</td><td>@elemento.TamanoPromedio</td><td>@elemento.PesoPromedio</td><td>@elemento.EsperanzaVidaAnios</td><td>@elemento.Descripcion</td><td><input type="submit" value="Editar" class="btn btn-secondary" asp-page-handler="BtEditar" asp-route-data="@elemento.Id"/> <input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id"/></td></tr>}</table></div>}</div></form>

