@model front_veterinaria.Pages.Ventanas.AnimalesModel
@{ ViewData["Title"]="Animales"; }
<form method="post"><div class="text-center"><h1 class="display-4">Animales</h1><div><input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" /> <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" /> <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" /><input placeholder="Buscar" asp-for="Filtro!.Nombre" /></div>@if(ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }@if(Model.Formulario||Model.Borrar) {<input type="hidden" asp-for="Actual!.Id" />}@if(Model.Formulario) {<div><h3>Animales</h3><label>Raza</label><input class="form-control" asp-for="Actual!.Raza" type="number" step="any" /><br />
<label>Cliente</label><input class="form-control" asp-for="Actual!.Cliente" type="number" step="any" /><br />
<label>Finca</label><input class="form-control" asp-for="Actual!.Finca" type="number" step="any" /><br />
<label>Nombre</label><input class="form-control" asp-for="Actual!.Nombre" type="text" step="any" /><br />
<label>Sexo</label><input class="form-control" asp-for="Actual!.Sexo" type="text" step="any" /><br />
<label>FechaNacimiento</label><input class="form-control" asp-for="Actual!.FechaNacimiento" type="date" step="any" /><br />
<label>Color</label><input class="form-control" asp-for="Actual!.Color" type="text" step="any" /><br />
<label>Peso</label><input class="form-control" asp-for="Actual!.Peso" type="number" step="any" /><br />
<label>Estado</label><input class="form-control" asp-for="Actual!.Estado" type="text" step="any" /><br /></div>}@if(Model.Borrar) {<div class="popup"><div class="pp_del_inner"><h3>Mensaje</h3><h4>�Quiere borrar el registro #@Model.Actual!.Id?</h4><input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar"/><input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtBorrar"/></div></div>}@if(!Model.Formulario) {<div class="containers_vn panel panel-default"><table class="tb_data table table-striped table-bordered table-hover"><tr><th>Raza</th><th>Cliente</th><th>Finca</th><th>Nombre</th><th>Sexo</th><th>FechaNacimiento</th><th>Color</th><th>Peso</th><th>Estado</th><th>Acci�n</th></tr>@foreach(var elemento in Model.Lista) {<tr><td>@elemento.Raza</td><td>@elemento.Cliente</td><td>@elemento.Finca</td><td>@elemento.Nombre</td><td>@elemento.Sexo</td><td>@elemento.FechaNacimiento</td><td>@elemento.Color</td><td>@elemento.Peso</td><td>@elemento.Estado</td><td><input type="submit" value="Editar" class="btn btn-secondary" asp-page-handler="BtEditar" asp-route-data="@elemento.Id"/> <input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id"/></td></tr>}</table></div>}</div></form>


