@page
@model front_veterinaria.Pages.Ventanas.DetalleComprasModel
@{ ViewData["Title"]="DetalleCompras"; }
<form method="post"><div class="text-center"><h1 class="display-4">DetalleCompras</h1><div><input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" /> <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" /> <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" /></div>@if(ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }@if(Model.Formulario||Model.Borrar) {<input type="hidden" asp-for="Actual!.Id" />}@if(Model.Formulario) {<div><h3>DetalleCompras</h3><label>Compra</label><input class="form-control" asp-for="Actual!.Compra" type="number" step="any" /><br />
<label>Producto</label><input class="form-control" asp-for="Actual!.Producto" type="number" step="any" /><br />
<label>Cantidad</label><input class="form-control" asp-for="Actual!.Cantidad" type="number" step="any" /><br />
<label>Precio</label><input class="form-control" asp-for="Actual!.Precio" type="number" step="any" /><br /></div>}@if(Model.Borrar) {<div class="popup"><div class="pp_del_inner"><h3>Mensaje</h3><h4>¿Quiere borrar el registro #@Model.Actual!.Id?</h4><input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar"/><input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtBorrar"/></div></div>}@if(!Model.Formulario) {<div class="containers_vn panel panel-default"><table class="tb_data table table-striped table-bordered table-hover"><tr><th>Compra</th><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Acción</th></tr>@foreach(var elemento in Model.Lista) {<tr><td>@elemento.Compra</td><td>@elemento.Producto</td><td>@elemento.Cantidad</td><td>@elemento.Precio</td><td><input type="submit" value="Editar" class="btn btn-secondary" asp-page-handler="BtEditar" asp-route-data="@elemento.Id"/> <input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id"/></td></tr>}</table></div>}</div></form>

