@page
@model front_veterinaria.Pages.Ventanas.EmpleadosModel
@{ ViewData["Title"]="Empleados"; }
<form method="post"><div class="text-center"><h1 class="display-4">Empleados</h1><div><input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" /> <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" /> <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" /><input placeholder="Buscar" asp-for="Filtro!.Cargo" /></div>@if(ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }@if(Model.Formulario||Model.Borrar) {<input type="hidden" asp-for="Actual!.Id" />}@if(Model.Formulario) {<div><h3>Empleados</h3><label>Persona</label><select class="form-control" asp-for="Actual!.Persona" asp-items="@(new SelectList(Model.Personas, "Id", "Nombre"))"></select><br />
<label>Cargo</label><input class="form-control" asp-for="Actual!.Cargo" type="text" step="any" /><br />
<label>FechaIngreso</label><input class="form-control" asp-for="Actual!.FechaIngreso" type="date" step="any" /><br />
<label>Salario</label><input class="form-control" asp-for="Actual!.Salario" type="number" step="any" /><br />
<label>Estado</label><input class="form-control" asp-for="Actual!.Estado" type="text" step="any" /><br />
<label>Turno</label><input class="form-control" asp-for="Actual!.Turno" type="text" step="any" /><br /></div>}@if(Model.Borrar) {<div class="popup"><div class="pp_del_inner"><h3>Mensaje</h3><h4>¿Quiere borrar el registro #@Model.Actual!.Id?</h4><input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar"/><input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtBorrar"/></div></div>}@if(!Model.Formulario) {<div class="containers_vn panel panel-default"><table class="tb_data table table-striped table-bordered table-hover"><tr><th>Persona</th><th>Cargo</th><th>FechaIngreso</th><th>Salario</th><th>Estado</th><th>Turno</th><th>Acción</th></tr>@foreach(var elemento in Model.Lista) {<tr><td>@(Model.Personas.FirstOrDefault(x => x.Id == elemento.Persona)?.Nombre)</td><td>@elemento.Cargo</td><td>@elemento.FechaIngreso</td><td>@elemento.Salario</td><td>@elemento.Estado</td><td>@elemento.Turno</td><td><input type="submit" value="Editar" class="btn btn-secondary" asp-page-handler="BtEditar" asp-route-data="@elemento.Id"/> <input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id"/></td></tr>}</table></div>}</div></form>

