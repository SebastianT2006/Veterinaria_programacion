@page
@model front_veterinaria.Pages.Ventanas.ConsultasModel
@{ ViewData["Title"]="Consultas"; }
<form method="post"><div class="text-center"><h1 class="display-4">Consultas</h1><div><input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" /> <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" /> <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" /><input placeholder="Buscar" asp-for="Filtro!.Diagnostico" /></div>@if(ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }@if(Model.Formulario||Model.Borrar) {<input type="hidden" asp-for="Actual!.Id" />}@if(Model.Formulario) {<div><h3>Consultas</h3><label>Cita</label><input class="form-control" asp-for="Actual!.Cita" type="number" step="any" /><br />
<label>Animal</label><select class="form-control" asp-for="Actual!.Animal" asp-items="@(new SelectList(Model.Animales, "Id", "Nombre"))"></select><br />
<label>Veterinario</label><input class="form-control" asp-for="Actual!.Veterinario" type="number" step="any" /><br />
<label>Fecha</label><input class="form-control" asp-for="Actual!.Fecha" type="date" step="any" /><br />
<label>Diagnostico</label><input class="form-control" asp-for="Actual!.Diagnostico" type="text" step="any" /><br />
<label>Observaciones</label><input class="form-control" asp-for="Actual!.Observaciones" type="text" step="any" /><br />
<label>PesoActual</label><input class="form-control" asp-for="Actual!.PesoActual" type="number" step="any" /><br />
<label>Temperatura</label><input class="form-control" asp-for="Actual!.Temperatura" type="number" step="any" /><br /></div>}@if(Model.Borrar) {<div class="popup"><div class="pp_del_inner"><h3>Mensaje</h3><h4>¿Quiere borrar el registro #@Model.Actual!.Id?</h4><input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar"/><input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtBorrar"/></div></div>}@if(!Model.Formulario) {<div class="containers_vn panel panel-default"><table class="tb_data table table-striped table-bordered table-hover"><tr><th>Id</th><th>Cita</th><th>Animal</th><th>Veterinario</th><th>Fecha</th><th>Diagnostico</th><th>Observaciones</th><th>PesoActual</th><th>Temperatura</th><th>Acción</th></tr>@foreach(var elemento in Model.Lista) {<tr><td>@elemento.Id</td><td>@elemento.Cita</td><td>@(Model.Animales.FirstOrDefault(x => x.Id == elemento.Animal)?.Nombre)</td><td>@elemento.Veterinario</td><td>@elemento.Fecha</td><td>@elemento.Diagnostico</td><td>@elemento.Observaciones</td><td>@elemento.PesoActual</td><td>@elemento.Temperatura</td><td><input type="submit" value="Editar" class="btn btn-secondary" asp-page-handler="BtEditar" asp-route-data="@elemento.Id"/> <input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id"/></td></tr>}</table></div>}</div></form>

