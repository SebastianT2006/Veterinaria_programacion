@page
@model front_veterinaria.Pages.Ventanas.ComprasModel
@{ ViewData["Title"]="Compras"; }
<form method="post"><div class="text-center"><h1 class="display-4">Compras</h1><div><input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" /> <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" /> <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" /><input placeholder="Buscar" asp-for="Filtro!.NumeroFactura" /></div>@if(ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }@if(Model.Formulario||Model.Borrar) {<input type="hidden" asp-for="Actual!.Id" />}@if(Model.Formulario) {<div><h3>Compras</h3><label>Proveedor</label><select class="form-control" asp-for="Actual!.Proveedor" asp-items="@(new SelectList(Model.Proveedores, "Id", "Nombre"))"></select><br />
<label>Fecha</label><input class="form-control" asp-for="Actual!.Fecha" type="date" step="any" /><br />
<label>Total</label><input class="form-control" asp-for="Actual!.Total" type="number" step="any" /><br />
<label>NumeroFactura</label><input class="form-control" asp-for="Actual!.NumeroFactura" type="text" step="any" /><br />
<label>Estado</label><input class="form-control" asp-for="Actual!.Estado" type="text" step="any" /><br />
<label>Observaciones</label><input class="form-control" asp-for="Actual!.Observaciones" type="text" step="any" /><br /></div>}@if(Model.Borrar) {<div class="popup"><div class="pp_del_inner"><h3>Mensaje</h3><h4>¿Quiere borrar el registro #@Model.Actual!.Id?</h4><input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar"/><input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtBorrar"/></div></div>}@if(!Model.Formulario) {<div class="containers_vn panel panel-default"><table class="tb_data table table-striped table-bordered table-hover"><tr><th>Id</th><th>Proveedor</th><th>Fecha</th><th>Total</th><th>NumeroFactura</th><th>Estado</th><th>Observaciones</th><th>Acción</th></tr>@foreach(var elemento in Model.Lista) {<tr><td>@elemento.Id</td><td>@(Model.Proveedores.FirstOrDefault(x => x.Id == elemento.Proveedor)?.Nombre)</td><td>@elemento.Fecha</td><td>@elemento.Total</td><td>@elemento.NumeroFactura</td><td>@elemento.Estado</td><td>@elemento.Observaciones</td><td><input type="submit" value="Editar" class="btn btn-secondary" asp-page-handler="BtEditar" asp-route-data="@elemento.Id"/> <input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id"/></td></tr>}</table></div>}</div></form>

