@page
@model front_veterinaria.Pages.Ventanas.ClientesModel
@{ ViewData["Title"]="Clientes"; }
<form method="post"><div class="text-center"><h1 class="display-4">Clientes</h1><div><input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" /> <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" /> <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" /><input placeholder="Buscar TipoCliente" asp-for="Filtro!.TipoCliente" /></div>@if(ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }@if(Model.Formulario||Model.Borrar) {<input type="hidden" asp-for="Actual!.Id" />}@if(Model.Formulario) {<div><h3>Clientes</h3><label>Persona</label><input class="form-control" asp-for="Actual!.Persona" type="number" step="any" /><br />
<label>TipoCliente</label><input class="form-control" asp-for="Actual!.TipoCliente" type="text" step="any" /><br />
<label>FechaRegistro</label><input class="form-control" asp-for="Actual!.FechaRegistro" type="date" step="any" /><br />
<label>Estado</label><input class="form-control" asp-for="Actual!.Estado" type="text" step="any" /><br />
<label>Observaciones</label><input class="form-control" asp-for="Actual!.Observaciones" type="text" step="any" /><br />
<label>PreferenciaContacto</label><input class="form-control" asp-for="Actual!.PreferenciaContacto" type="text" step="any" /><br /></div>}@if(Model.Borrar) {<div class="popup"><div class="pp_del_inner"><h3>Mensaje</h3><h4>�Quiere borrar el registro #@Model.Actual!.Id?</h4><input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar"/><input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtBorrar"/></div></div>}@if(!Model.Formulario) {<div class="containers_vn panel panel-default"><table class="tb_data table table-striped table-bordered table-hover"><tr><th>Persona</th><th>TipoCliente</th><th>FechaRegistro</th><th>Estado</th><th>Observaciones</th><th>PreferenciaContacto</th><th>Acci�n</th></tr>@foreach(var elemento in Model.Lista) {<tr><td>@elemento.Persona</td><td>@elemento.TipoCliente</td><td>@elemento.FechaRegistro</td><td>@elemento.Estado</td><td>@elemento.Observaciones</td><td>@elemento.PreferenciaContacto</td><td><input type="submit" value="Editar" class="btn btn-secondary" asp-page-handler="BtEditar" asp-route-data="@elemento.Id"/> <input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id"/></td></tr>}</table></div>}</div></form>

