@page
@model front_veterinaria.Pages.Ventanas.ServiciosModel
@{ ViewData["Title"]="Servicios"; }
<form method="post"><div class="text-center"><h1 class="display-4">Servicios</h1><div><input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" /> <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" /> <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" /><input placeholder="Buscar" asp-for="Filtro!.Nombre" /></div>@if(ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }@if(Model.Formulario||Model.Borrar) {<input type="hidden" asp-for="Actual!.Id" />}@if(Model.Formulario) {<div><h3>Servicios</h3><label>Nombre</label><input class="form-control" asp-for="Actual!.Nombre" type="text" step="any" /><br />
<label>Descripcion</label><input class="form-control" asp-for="Actual!.Descripcion" type="text" step="any" /><br />
<label>Precio</label><input class="form-control" asp-for="Actual!.Precio" type="number" step="any" /><br />
<label>Duracion</label><input class="form-control" asp-for="Actual!.Duracion" type="number" step="any" /><br />
<label>Categoria</label><input class="form-control" asp-for="Actual!.Categoria" type="text" step="any" /><br /></div>}@if(Model.Borrar) {<div class="popup"><div class="pp_del_inner"><h3>Mensaje</h3><h4>¿Quiere borrar el registro #@Model.Actual!.Id?</h4><input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar"/><input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtBorrar"/></div></div>}@if(!Model.Formulario) {<div class="containers_vn panel panel-default"><table class="tb_data table table-striped table-bordered table-hover"><tr><th>Nombre</th><th>Descripcion</th><th>Precio</th><th>Duracion</th><th>Categoria</th><th>Acción</th></tr>@foreach(var elemento in Model.Lista) {<tr><td>@elemento.Nombre</td><td>@elemento.Descripcion</td><td>@elemento.Precio</td><td>@elemento.Duracion</td><td>@elemento.Categoria</td><td><input type="submit" value="Editar" class="btn btn-secondary" asp-page-handler="BtEditar" asp-route-data="@elemento.Id"/> <input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id"/></td></tr>}</table></div>}</div></form>

