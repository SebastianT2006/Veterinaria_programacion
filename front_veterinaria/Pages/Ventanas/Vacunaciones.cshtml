@page
@model front_veterinaria.Pages.Ventanas.VacunacionesModel
@{ ViewData["Title"]="Vacunaciones"; }
<form method="post"><div class="text-center"><h1 class="display-4">Vacunaciones</h1><div><input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" /> <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" /> <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" /><input placeholder="Buscar Observacion" asp-for="Filtro!.Observacion" /></div>@if(ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }@if(Model.Formulario||Model.Borrar) {<input type="hidden" asp-for="Actual!.Id" />}@if(Model.Formulario) {<div><h3>Vacunaciones</h3><label>Animal</label><input class="form-control" asp-for="Actual!.Animal" type="number" step="any" /><br />
<label>Producto</label><input class="form-control" asp-for="Actual!.Producto" type="number" step="any" /><br />
<label>Fecha</label><input class="form-control" asp-for="Actual!.Fecha" type="date" step="any" /><br />
<label>Observacion</label><input class="form-control" asp-for="Actual!.Observacion" type="text" step="any" /><br />
<label>ProximaFecha</label><input class="form-control" asp-for="Actual!.ProximaFecha" type="date" step="any" /><br />
<label>Lote</label><input class="form-control" asp-for="Actual!.Lote" type="text" step="any" /><br />
<label>Dosis</label><input class="form-control" asp-for="Actual!.Dosis" type="number" step="any" /><br /></div>}@if(Model.Borrar) {<div class="popup"><div class="pp_del_inner"><h3>Mensaje</h3><h4>�Quiere borrar el registro #@Model.Actual!.Id?</h4><input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar"/><input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtBorrar"/></div></div>}@if(!Model.Formulario) {<div class="containers_vn panel panel-default"><table class="tb_data table table-striped table-bordered table-hover"><tr><th>Animal</th><th>Producto</th><th>Fecha</th><th>Observacion</th><th>ProximaFecha</th><th>Lote</th><th>Dosis</th><th>Acci�n</th></tr>@foreach(var elemento in Model.Lista) {<tr><td>@elemento.Animal</td><td>@elemento.Producto</td><td>@elemento.Fecha</td><td>@elemento.Observacion</td><td>@elemento.ProximaFecha</td><td>@elemento.Lote</td><td>@elemento.Dosis</td><td><input type="submit" value="Editar" class="btn btn-secondary" asp-page-handler="BtEditar" asp-route-data="@elemento.Id"/> <input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id"/></td></tr>}</table></div>}</div></form>

