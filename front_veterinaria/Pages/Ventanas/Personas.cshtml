@page
@model front_veterinaria.Pages.Ventanas.PersonasModel
@{ ViewData["Title"]="Personas"; }
<form method="post"><div class="text-center"><h1 class="display-4">Personas</h1><div><input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" /> <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" /> <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" /> <input type="submit" value="PDF" class="btn btn-secondary" asp-page-handler="BtPdf" /><input placeholder="Buscar" asp-for="Filtro!.Nombre" /></div>@if(ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }@if(Model.Formulario||Model.Borrar) {<input type="hidden" asp-for="Actual!.Id" />}@if(Model.Formulario) {<div><h3>Personas</h3><label>Nombre</label><input class="form-control" asp-for="Actual!.Nombre" type="text" step="any" /><br />
<label>Telefono</label><input class="form-control" asp-for="Actual!.Telefono" type="text" step="any" /><br />
<label>Email</label><input class="form-control" asp-for="Actual!.Email" type="text" step="any" /><br />
<label>Direccion</label><input class="form-control" asp-for="Actual!.Direccion" type="text" step="any" /><br />
<label>FechaNacimiento</label><input class="form-control" asp-for="Actual!.FechaNacimiento" type="date" step="any" /><br /></div>}@if(Model.Borrar) {<div class="popup"><div class="pp_del_inner"><h3>Mensaje</h3><h4>¿Quiere borrar el registro #@Model.Actual!.Id?</h4><input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar"/><input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtBorrar"/></div></div>}@if(!Model.Formulario) {<div class="containers_vn panel panel-default"><table class="tb_data table table-striped table-bordered table-hover"><tr><th>Nombre</th><th>Telefono</th><th>Email</th><th>Direccion</th><th>FechaNacimiento</th><th>Acción</th></tr>@foreach(var elemento in Model.Lista) {<tr><td>@elemento.Nombre</td><td>@elemento.Telefono</td><td>@elemento.Email</td><td>@elemento.Direccion</td><td>@elemento.FechaNacimiento</td><td><input type="submit" value="Editar" class="btn btn-secondary" asp-page-handler="BtEditar" asp-route-data="@elemento.Id"/> <input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id"/></td></tr>}</table></div>}</div></form>

