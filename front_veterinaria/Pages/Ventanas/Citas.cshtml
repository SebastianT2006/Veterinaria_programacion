@page
@model front_veterinaria.Pages.Ventanas.CitasModel
@{ ViewData["Title"]="Citas"; }
<form method="post"><div class="text-center"><h1 class="display-4">Citas</h1><div><input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" /> <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" /> <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" /><input placeholder="Buscar Motivo" asp-for="Filtro!.Motivo" /></div>@if(ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }@if(Model.Formulario||Model.Borrar) {<input type="hidden" asp-for="Actual!.Id" />}@if(Model.Formulario) {<div><h3>Citas</h3><label>Animal</label><input class="form-control" asp-for="Actual!.Animal" type="number" step="any" /><br />
<label>Veterinario</label><input class="form-control" asp-for="Actual!.Veterinario" type="number" step="any" /><br />
<label>Fecha</label><input class="form-control" asp-for="Actual!.Fecha" type="date" step="any" /><br />
<label>Hora</label><input class="form-control" asp-for="Actual!.Hora" type="time" step="any" /><br />
<label>Motivo</label><input class="form-control" asp-for="Actual!.Motivo" type="text" step="any" /><br />
<label>Estado</label><input class="form-control" asp-for="Actual!.Estado" type="text" step="any" /><br />
<label>Observaciones</label><input class="form-control" asp-for="Actual!.Observaciones" type="text" step="any" /><br /></div>}@if(Model.Borrar) {<div class="popup"><div class="pp_del_inner"><h3>Mensaje</h3><h4>�Quiere borrar el registro #@Model.Actual!.Id?</h4><input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar"/><input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtBorrar"/></div></div>}@if(!Model.Formulario) {<div class="containers_vn panel panel-default"><table class="tb_data table table-striped table-bordered table-hover"><tr><th>Animal</th><th>Veterinario</th><th>Fecha</th><th>Hora</th><th>Motivo</th><th>Estado</th><th>Observaciones</th><th>Acci�n</th></tr>@foreach(var elemento in Model.Lista) {<tr><td>@elemento.Animal</td><td>@elemento.Veterinario</td><td>@elemento.Fecha</td><td>@elemento.Hora</td><td>@elemento.Motivo</td><td>@elemento.Estado</td><td>@elemento.Observaciones</td><td><input type="submit" value="Editar" class="btn btn-secondary" asp-page-handler="BtEditar" asp-route-data="@elemento.Id"/> <input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id"/></td></tr>}</table></div>}</div></form>

