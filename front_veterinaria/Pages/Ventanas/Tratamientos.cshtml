@page
@model front_veterinaria.Pages.Ventanas.TratamientosModel
@{ ViewData["Title"]="Tratamientos"; }
<form method="post"><div class="text-center"><h1 class="display-4">Tratamientos</h1><div><input type="submit" value="Consultar" class="btn btn-secondary" asp-page-handler="BtConsultar" /> <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" /> <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" /><input placeholder="Buscar" asp-for="Filtro!.Frecuencia" /></div>@if(ViewData.ContainsKey("Mensaje")) { @await Html.PartialAsync("../Emergentes/Mensajes.cshtml") }@if(Model.Formulario||Model.Borrar) {<input type="hidden" asp-for="Actual!.Id" />}@if(Model.Formulario) {<div><h3>Tratamientos</h3><label>Animal</label><input class="form-control" asp-for="Actual!.Animal" type="number" step="any" /><br />
<label>Consulta</label><input class="form-control" asp-for="Actual!.Consulta" type="number" step="any" /><br />
<label>Producto</label><input class="form-control" asp-for="Actual!.Producto" type="number" step="any" /><br />
<label>Dosis</label><input class="form-control" asp-for="Actual!.Dosis" type="number" step="any" /><br />
<label>Frecuencia</label><input class="form-control" asp-for="Actual!.Frecuencia" type="text" step="any" /><br />
<label>Duracion</label><input class="form-control" asp-for="Actual!.Duracion" type="number" step="any" /><br />
<label>Indicaciones</label><input class="form-control" asp-for="Actual!.Indicaciones" type="text" step="any" /><br />
<label>FechaInicio</label><input class="form-control" asp-for="Actual!.FechaInicio" type="date" step="any" /><br /></div>}@if(Model.Borrar) {<div class="popup"><div class="pp_del_inner"><h3>Mensaje</h3><h4>¿Quiere borrar el registro #@Model.Actual!.Id?</h4><input type="submit" value="Cancelar" class="btn btn-secondary" asp-page-handler="BtConsultar"/><input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtBorrar"/></div></div>}@if(!Model.Formulario) {<div class="containers_vn panel panel-default"><table class="tb_data table table-striped table-bordered table-hover"><tr><th>Animal</th><th>Consulta</th><th>Producto</th><th>Dosis</th><th>Frecuencia</th><th>Duracion</th><th>Indicaciones</th><th>FechaInicio</th><th>Acción</th></tr>@foreach(var elemento in Model.Lista) {<tr><td>@elemento.Animal</td><td>@elemento.Consulta</td><td>@elemento.Producto</td><td>@elemento.Dosis</td><td>@elemento.Frecuencia</td><td>@elemento.Duracion</td><td>@elemento.Indicaciones</td><td>@elemento.FechaInicio</td><td><input type="submit" value="Editar" class="btn btn-secondary" asp-page-handler="BtEditar" asp-route-data="@elemento.Id"/> <input type="submit" value="Borrar" class="btn btn-secondary" asp-page-handler="BtPregBorrar" asp-route-data="@elemento.Id"/></td></tr>}</table></div>}</div></form>

