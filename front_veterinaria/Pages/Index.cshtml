@page
@model IndexModel
@{
    ViewData["Title"] = "Veterinaria";
}
<form method="post">
    <div class="text-center">
        <h1 class="display-4">Sistema Veterinario</h1>
        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("~/Pages/Emergentes/Mensajes.cshtml")
        }
        @if (string.IsNullOrEmpty(Model.Usuario))
        {
            <p>Ingrese con su usuario y contraseña.</p>
            <div class="mx-auto" style="max-width: 320px;">
                <label>Usuario</label>
                <input class="form-control" asp-for="Datos.NombreUsuario" type="text" /><br />
                <label>Contraseña</label>
                <input class="form-control" asp-for="Datos.Contrasena" type="password" /><br />
                <input type="submit" value="Ingresar" class="btn btn-secondary" asp-page-handler="BtIngresar" />
            </div>
        }
        else
        {
            <p>Bienvenido, <strong>@Model.Usuario</strong> (@Model.Rol). Seleccione una ventana en el menú.</p>
        }
    </div>
</form>
