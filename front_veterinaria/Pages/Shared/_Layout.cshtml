@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - front_veterinaria</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/front_veterinaria.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">front_veterinaria</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                    var rol = Context.Session.GetString("Rol");
                    var usuarioActual = Context.Session.GetString("Usuario");
                    var consultorio = new[] { "Personas", "Clientes", "Fincas", "Animales", "Razas", "Citas", "Consultas", "HistoriasClinicas", "Vacunaciones", "Tratamientos" };
                    var administracion = new[] { "Compras", "DetalleCompras", "DetalleFacturas", "Empleados", "Facturas", "Productos", "Proveedores", "Servicios", "Veterinarios", "Especies", "Roles", "Usuarios", "Auditorias" };
                    var ventanas = rol == "Administrador" ? consultorio.Concat(administracion).OrderBy(x => x).ToArray()
                        : rol == "Usuario" ? consultorio.OrderBy(x => x).ToArray()
                        : Array.Empty<string>();
                }
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-page="/Index">Inicio</a></li>
                    @foreach (var ventana in ventanas)
                    {
                        var ruta = "/Ventanas/" + ventana;
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="@ruta">@ventana</a></li>
                    }
                    <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacidad</a></li>
                    @if (!string.IsNullOrEmpty(usuarioActual))
                    {
                        <li class="nav-item ms-auto"><span class="navbar-text me-2">@usuarioActual (@rol)</span></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-area="" asp-page="/Salir">Salir</a></li>
                    }
                </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Aviso"] != null)
            {
                <div class="alert alert-warning text-center">@TempData["Aviso"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - front_veterinaria - <a asp-area="" asp-page="/Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
