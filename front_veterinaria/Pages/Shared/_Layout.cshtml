<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - front_veterinaria</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/front_veterinaria.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">front_veterinaria</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" 
                                asp-area="" 
                               asp-page="/Index">Inicio</a>
                        </li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Animales">Animales</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Citas">Citas</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Clientes">Clientes</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Compras">Compras</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Consultas">Consultas</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/DetalleCompras">DetalleCompras</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/DetalleFacturas">DetalleFacturas</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Empleados">Empleados</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Especies">Especies</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Facturas">Facturas</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Fincas">Fincas</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/HistoriasClinicas">HistoriasClinicas</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Personas">Personas</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Productos">Productos</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Proveedores">Proveedores</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Razas">Razas</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Servicios">Servicios</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Tratamientos">Tratamientos</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Vacunaciones">Vacunaciones</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Ventanas/Veterinarios">Veterinarios</a></li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" 
                                asp-area="" asp-page="/Privacy">Privacidad</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - front_veterinaria - <a asp-area="" asp-page="/Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
